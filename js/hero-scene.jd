import * as THREE from 'three';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';

const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
const canvas = document.getElementById('hero-canvas');
const hero = document.getElementById('home');
if (canvas) init();

function init(){
  const renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio||1, 2));
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
  camera.position.set(0, 2.4, 11);
  camera.lookAt(0, 1.4, 0);

  /* ---------- 主题色板 ---------- */
  const PALETTE = {
    light:{ bg:0xe9f0ea, fog:0xe9f0ea, m:[0xc7d8d0,0x9dbcb1,0x7fa79a,0x5f8b7e],
      waterA:0x2e6e67, waterB:0x6fb0a3, sun:0xc96f52, boat:0x33403c, particle:0x2e6e67 },
    dark:{ bg:0x0f1d1b, fog:0x0f1d1b, m:[0x203734,0x1a2f2b,0x162824,0x12211d],
      waterA:0x0a2622, waterB:0x2a6a5e, sun:0xb05a44, boat:0xbcd4cc, particle:0x63bfae }
  };
  let theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  const P = () => PALETTE[theme];

  scene.fog = new THREE.Fog(P().fog, 6, 24);

  /* ---------- 程序化山体（多层剪影 + 雾） ---------- */
  function ridge(t, seed){
    return (Math.sin(t*Math.PI*3+seed)*0.5 + Math.sin(t*Math.PI*7.3+seed*1.7)*0.3 +
            Math.sin(t*Math.PI*13.7+seed*2.3)*0.2)*0.5+0.5;
  }
  const mountains = [];
  function buildMountains(){
    mountains.forEach(m=>scene.remove(m)); mountains.length=0;
    const layers = [ {w:60,h:7,z:-14,seed:1.3},{w:52,h:6,z:-10,seed:4.7},
                     {w:44,h:5,z:-6,seed:8.1},{w:38,h:4.2,z:-2.5,seed:12.6} ];
    layers.forEach((L,i)=>{
      const shape = new THREE.Shape(); const seg=90;
      shape.moveTo(-L.w/2,0);
      for(let s=0;s<=seg;s++){ const t=s/seg; const x=-L.w/2+t*L.w;
        const env=Math.pow(Math.sin(t*Math.PI),0.7);
        shape.lineTo(x, ridge(t,L.seed)*L.h*env); }
      shape.lineTo(L.w/2,0); shape.closePath();
      const geo = new THREE.ShapeGeometry(shape, seg);
      const mat = new THREE.MeshBasicMaterial({color:P().m[i], side:THREE.DoubleSide});
      const mesh = new THREE.Mesh(geo, mat); mesh.position.z=L.z;
      scene.add(mesh); mountains.push(mesh);
    });
  }
  buildMountains();

  /* ---------- 落日（Bloom 发光） ---------- */
  const sun = new THREE.Mesh(new THREE.CircleGeometry(1.4,48),
    new THREE.MeshBasicMaterial({color:P().sun}));
  sun.position.set(5.5, 5.2, -13); scene.add(sun);

  /* ---------- 着色器水面 ---------- */
  const waterUniforms = { u_time:{value:0}, u_deep:{value:new THREE.Color(P().waterA)},
    u_shallow:{value:new THREE.Color(P().waterB)} };
  const waterMat = new THREE.ShaderMaterial({
    uniforms:waterUniforms, transparent:true,
    vertexShader:`uniform float u_time;varying vec2 vUv;varying float vE;
      void main(){vUv=uv;vec3 p=position;
      float w=sin(p.x*1.2+u_time)*.06+sin(p.y*2.1+u_time*1.4)*.05+sin((p.x+p.y)*.8+u_time*.7)*.04;
      p.z+=w;vE=w;gl_Position=projectionMatrix*modelViewMatrix*vec4(p,1.);}`,
    fragmentShader:`uniform vec3 u_deep;uniform vec3 u_shallow;varying vec2 vUv;varying float vE;
      void main(){float m=clamp((vE+.15)*4.,0.,1.);vec3 c=mix(u_deep,u_shallow,m);
      float sp=step(.985,fract(sin(dot(vUv*120.,vec2(12.9898,78.233)))*43758.5453));
      c+=sp*.25;gl_FragColor=vec4(c,.92);}`
  });
  const water = new THREE.Mesh(new THREE.PlaneGeometry(70,34,64,64), waterMat);
  water.rotation.x=-Math.PI/2; water.position.set(0,0,-4); scene.add(water);

  /* ---------- 3D 孤舟 ---------- */
  const boat = new THREE.Group();
  const bmat = new THREE.MeshBasicMaterial({color:P().boat});
  const hullShape=new THREE.Shape();
  hullShape.moveTo(-1.2,0);hullShape.quadraticCurveTo(-1.3,.25,-.9,.3);
  hullShape.lineTo(.9,.3);hullShape.quadraticCurveTo(1.3,.25,1.2,0);
  hullShape.quadraticCurveTo(.6,-.2,0,-.2);hullShape.quadraticCurveTo(-.6,-.2,-1.2,0);
  const hull=new THREE.Mesh(new THREE.ExtrudeGeometry(hullShape,{depth:.4,bevelEnabled:false}),bmat);
  hull.position.z=-.2; boat.add(hull);
  const sailShape=new THREE.Shape();
  sailShape.moveTo(0,0);sailShape.lineTo(.75,.15);sailShape.lineTo(.55,1.25);sailShape.lineTo(.08,1.35);sailShape.closePath();
  const sail=new THREE.Mesh(new THREE.ShapeGeometry(sailShape),
    new THREE.MeshBasicMaterial({color:P().boat,side:THREE.DoubleSide}));
  sail.position.set(.05,.3,.05); boat.add(sail);
  boat.scale.setScalar(.9); boat.position.set(-2.2,.15,1.5); scene.add(boat);

  /* ---------- 3D 粒子（萤光/海雾） ---------- */
  const PCOUNT=260; const pgeo=new THREE.BufferGeometry();
  const ppos=new Float32Array(PCOUNT*3), pseed=new Float32Array(PCOUNT);
  for(let i=0;i<PCOUNT;i++){ ppos[i*3]=(Math.random()-.5)*30; ppos[i*3+1]=Math.random()*6;
    ppos[i*3+2]=-Math.random()*16; pseed[i]=Math.random()*Math.PI*2; }
  pgeo.setAttribute('position',new THREE.BufferAttribute(ppos,3));
  pgeo.setAttribute('aSeed',new THREE.BufferAttribute(pseed,1));
  const pmat=new THREE.ShaderMaterial({
    uniforms:{u_time:{value:0},u_color:{value:new THREE.Color(P().particle)},u_dpr:{value:Math.min(devicePixelRatio||1,2)}},
    transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,
    vertexShader:`uniform float u_time;uniform float u_dpr;attribute float aSeed;varying float vA;
      void main(){vec3 p=position;p.y+=sin(u_time*.5+aSeed)*.4;p.x+=cos(u_time*.3+aSeed*1.7)*.4;
      vec4 mv=modelViewMatrix*vec4(p,1.);gl_Position=projectionMatrix*mv;
      gl_PointSize=(2.+3.*sin(u_time+aSeed))*u_dpr*(8./-mv.z);
      vA=.3+.4*sin(u_time*.8+aSeed*2.);}`,
    fragmentShader:`uniform vec3 u_color;varying float vA;
      void main(){float d=length(gl_PointCoord-.5);if(d>.5)discard;
      gl_FragColor=vec4(u_color,vA*smoothstep(.5,.0,d));}`
  });
  const points=new THREE.Points(pgeo,pmat); scene.add(points);

  /* ---------- 后期：Bloom + CRT ---------- */
  const CRTShader={
    uniforms:{tDiffuse:{value:null},u_time:{value:0},u_res:{value:new THREE.Vector2(1,1)},
      u_scan:{value:.06},u_vig:{value:.5},u_noise:{value:.03},u_ca:{value:.0012}},
    vertexShader:`varying vec2 vUv;void main(){vUv=uv;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,
    fragmentShader:`uniform sampler2D tDiffuse;uniform float u_time;uniform vec2 u_res;
      uniform float u_scan;uniform float u_vig;uniform float u_noise;uniform float u_ca;varying vec2 vUv;
      float rand(vec2 c){return fract(sin(dot(c,vec2(12.9898,78.233)))*43758.5453);}
      void main(){vec2 uv=vUv;
        vec4 cr=texture2D(tDiffuse,uv+vec2(u_ca,0.));vec4 cg=texture2D(tDiffuse,uv);vec4 cb=texture2D(tDiffuse,uv-vec2(u_ca,0.));
        vec4 col=vec4(cr.r,cg.g,cb.b,cg.a);
        float scan=sin(uv.y*u_res.y*1.2)*.5+.5;col.rgb-=scan*u_scan;
        col.rgb+=rand(uv*u_time)*u_noise;
        float d=distance(uv,vec2(.5));col.rgb*=1.-d*u_vig;
        gl_FragColor=col;}`
  };
  const composer=new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene,camera));
  const bloom=new UnrealBloomPass(new THREE.Vector2(1,1),0.55,0.9,0.82);
  composer.addPass(bloom);
  const crt=new ShaderPass(CRTShader); composer.addPass(crt);

  /* ---------- 交互：鼠标视差 + 滚动推镜 ---------- */
  let mx=0,my=0,tx=0,ty=0,scrollP=0;
  hero.addEventListener('mousemove',e=>{const r=hero.getBoundingClientRect();
    tx=((e.clientX-r.left)/r.width-.5); ty=((e.clientY-r.top)/r.height-.5);},{passive:true});
  hero.addEventListener('mouseleave',()=>{tx=0;ty=0;});
  addEventListener('scroll',()=>{const r=hero.getBoundingClientRect();
    scrollP=Math.min(1,Math.max(0,-r.top/r.height));},{passive:true});

  /* ---------- 主题切换 ---------- */
  function applyTheme(){
    scene.fog.color.set(P().fog);
    mountains.forEach((m,i)=>m.material.color.set(P().m[i]));
    sun.material.color.set(P().sun);
    waterUniforms.u_deep.value.set(P().waterA);
    waterUniforms.u_shallow.value.set(P().waterB);
    boat.children.forEach(c=>c.material.color.set(P().boat));
    pmat.uniforms.u_color.value.set(P().particle);
    bloom.strength = theme==='dark'?0.85:0.45;
    crt.uniforms.u_scan.value = theme==='dark'?0.08:0.05;
  }
  document.addEventListener('themechange',e=>{theme=e.detail;applyTheme();});
  applyTheme();

  /* ---------- 尺寸 ---------- */
  function resize(){
    const w=hero.clientWidth,h=hero.clientHeight;
    renderer.setSize(w,h,false); composer.setSize(w,h);
    camera.aspect=w/h; camera.updateProjectionMatrix();
    crt.uniforms.u_res.value.set(w*Math.min(devicePixelRatio||1,2),h*Math.min(devicePixelRatio||1,2));
  }
  resize(); addEventListener('resize',resize);

  /* ---------- 渲染循环 ---------- */
  const clock=new THREE.Clock();
  function loop(){
    const t=clock.getElapsedTime();
    waterUniforms.u_time.value=t; pmat.uniforms.u_time.value=t; crt.uniforms.u_time.value=t;
    // 相机：鼠标视差 + 滚动缓慢推进
    mx+=(tx-mx)*.04; my+=(ty-my)*.04;
    camera.position.x=mx*1.6; camera.position.y=2.4-my*1.0+scrollP*0.6;
    camera.position.z=11-scrollP*2.2;
    camera.lookAt(mx*0.6,1.4-my*0.4,0);
    // 孤舟浮动
    if(!reduced){ boat.position.y=.15+Math.sin(t*1.2)*.08;
      boat.rotation.z=Math.sin(t*1.2)*.04; boat.rotation.x=Math.sin(t*.9)*.03; }
    composer.render();
    requestAnimationFrame(loop);
  }
  if(reduced){ composer.render(); } else { loop(); }
}